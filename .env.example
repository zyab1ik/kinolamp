# Copy to .env on the VPS. Never commit .env.
ENABLE_PROXY=false
# Required only for the optional HLS proxy. HTTPS origin, no trailing slash.
PUBLIC_BASE_URL=https://lampa.example.com
# Generate locally: openssl rand -hex 32
PROXY_TOKEN=
# Empty by default: fail closed. Exact host or .suffix, comma separated.
# Add only trusted CDN domains returned by KinoPub for your account.
CDN_HOSTS=
# Exact origin of YOUR Lampa app, not this plugin's URL (unless same-origin).
# Add null only for native/file-origin TV clients that actually send Origin: null.
# Requests with no Origin still require the proxy key.
ALLOWED_ORIGINS=https://your-lampa-app.example.com
